{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tax-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/admin"]
  },
  "observability": {
    "enabled": true
  },
  "r2_buckets": [
    {
      "binding": "TAX_DATA",
      "bucket_name": "tax-app-data"
    }
  ]
}
