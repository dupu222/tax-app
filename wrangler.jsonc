{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tax-app",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-04",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "API_UPSTREAM": "http://api.ump45.top:19011"
  }
}
