{
  "name": "tax-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.11.1",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "vite --mode dev",
    "build": "vite build --mode prd",
    "build:prd": "vite build --mode prd",
    "preview": "vite preview",
    "preview:cf": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "test": "node --test worker/*.test.js"
  },
  "cloudflare": {
    "bindings": {
      "TAX_DATA": {
        "description": "存放全部业务 JSON 的 R2 桶。Worker 每次请求都会重新读取 `data.json`。"
      },
      "ADMIN_KEY": {
        "description": "管理后台密钥。访问 `/admin` 后填入，请求头为 `X-Admin-Key`。请在 Workers Secrets 中配置，不要写进代码。"
      },
      "TOKEN_SECRET": {
        "description": "签发用户登录 token 的 HMAC 密钥。未配置时回退使用 `ADMIN_KEY`。"
      }
    }
  },
  "dependencies": {
    "amfe-flexible": "2.2.1",
    "axios": "1.3.2",
    "pinia": "2.0.30",
    "pinia-plugin-persistedstate": "3.0.2",
    "vant": "4.0.10",
    "vue": "3.2.47",
    "vue-router": "4.1.6"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "eslint": "8.34.0",
    "eslint-config-airbnb-base": "15.0.0",
    "eslint-config-prettier": "8.6.0",
    "eslint-define-config": "1.15.0",
    "eslint-plugin-import": "2.27.5",
    "eslint-plugin-prettier": "4.2.1",
    "eslint-plugin-vue": "9.9.0",
    "postcss-html": "1.5.0",
    "postcss-pxtorem": "5.1.1",
    "postcss-sass": "0.5.0",
    "prettier": "2.8.4",
    "sass": "1.58.0",
    "stylelint": "15.1.0",
    "stylelint-config-html": "1.1.0",
    "stylelint-config-prettier": "9.0.5",
    "stylelint-config-recess-order": "3.1.0",
    "stylelint-config-standard": "30.0.1",
    "stylelint-less": "1.0.6",
    "stylelint-order": "6.0.2",
    "unplugin-vue-components": "0.23.0",
    "vite": "^4.1.0",
    "vue-eslint-parser": "9.1.0",
    "wrangler": "^4.37.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild", "workerd", "vue-demi"]
  }
}
